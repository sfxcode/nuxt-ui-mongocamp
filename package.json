{
  "name": "@sfxcode/nuxt-ui-mongocamp",
  "version": "1.2.7",
  "description": "A Nuxt module that wraps @sfxcode/nuxt-mongocamp-server with ready-made UI components, composables, and a runtime plugin",
  "repository": "sfxcode/nuxt-ui-mongocamp",
  "homepage": "https://sfxcode.github.io/nuxt-ui-mongocamp/",
  "bugs": "https://github.com/sfxcode/nuxt-ui-mongocamp/issues",
  "author": "sfxcode",
  "license": "MIT",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "mongocamp",
    "mongodb",
    "vue",
    "nuxt-ui"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --minor --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run --project unit --project components",
    "test:watch": "vitest watch",
    "test:e2e:auth": "vitest run --project e2e-auth",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@formkit/nuxt": "^2.1.2",
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@sfxcode/nuxt-mongocamp-server": "^1.5.2",
    "@sfxcode/nuxt-ui-formkit": "^1.4.1",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "minimatch": "^10.2.6",
    "unocss-nuxt-ui": "^1.2.2"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@nuxt/devtools": "4.0.0-beta.5",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/kit": "^4.6.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "latest",
    "@unhead/vue": "^3.4.3",
    "@vue/test-utils": "^2.5.1",
    "changelogen": "^0.6.2",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.3",
    "nuxt": "^4.6.2",
    "typescript": "~6.0.3",
    "vitepress": "2.0.0-alpha.18",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
